{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReaderReport",
  "description": "The one JSON object that a reader of a doc review returns.",
  "type": "object",
  "required": ["reader", "findings", "questions"],
  "additionalProperties": false,
  "properties": {
    "reader": {"type": "string", "enum": ["unslop", "asd-ste100", "content-lens"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["where", "rule", "edit", "why"],
        "additionalProperties": false,
        "properties": {
          "where": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1},
          "edit": {"type": "string", "minLength": 1},
          "why": {"type": "string", "minLength": 1}
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["where", "question"],
        "additionalProperties": false,
        "properties": {
          "where": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
